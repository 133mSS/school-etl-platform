# .env.example
# Sao chép file này thành .env và điền giá trị thật:
#   cp .env.example .env

# ── SOURCE DATABASE ──────────────────────────────
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5434
SOURCE_DB_NAME=school_source
SOURCE_DB_USER=school_user
SOURCE_DB_PASS=CHANGE_ME

# ── WAREHOUSE DATABASE ────────────────────────────
WH_DB_HOST=localhost
WH_DB_PORT=5435
WH_DB_NAME=school_warehouse
WH_DB_USER=warehouse_user
WH_DB_PASS=CHANGE_ME

# ── MINIO (Staging) ───────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_STAGING=staging-data

# ── AIRFLOW ───────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=CHANGE_ME

# ── ALERT ─────────────────────────────────────────
ALERT_EMAIL=your-email@example.com

# ── ETL ───────────────────────────────────────────
ETL_BATCH_SIZE=500
ETL_LOG_LEVEL=INFO
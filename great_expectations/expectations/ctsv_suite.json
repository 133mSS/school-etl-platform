            "meta": {
                "exp_id": "EXP-13",
                "applies_to": "ctsv",
                "notes": "ĐRL trong [0,100]. mostly=0.92 vì inject_errors.py inject ~8% lỗi."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_in_set",
            "kwargs": {

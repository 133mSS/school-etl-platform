            }
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "ma_sinh_vien"
            },
            "meta": {
                "exp_id": "EXP-12a",
                "applies_to": "ctsv",
                "notes": "Mã SV không được NULL — cần để join với dim_sinh_vien."
            }
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "hoc_ky"

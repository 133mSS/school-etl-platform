        },
        {
            "expectation_type": "expect_compound_columns_to_be_unique",
            "kwargs": {
                "column_list": [
                    "ma_sinh_vien",
                    "hoc_ky"
                ]
            },
            "meta": {
                "exp_id": "EXP-DUP",
                "applies_to": "ctsv",
                "notes": "Mỗi SV chỉ có 1 record/học kỳ."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "diem_ren_luyen",

{
    "data_asset_type": null,
    "expectation_suite_name": "tai_chinh_suite",
    "ge_cloud_id": null,
    "meta": {
        "great_expectations_version": "0.18.8",
        "description": "Validate Nguồn 3 API JSON — dữ liệu học phí, nợ, miễn giảm từ Portal Tài chính vendor. TÁCH RIÊNG khỏi ctsv_suite để tránh KeyError khi cột không tồn tại.",
        "owner": "Nhom8 ETL Platform PTIT",
        "updated": "2026-01-01",
        "data_asset": "tai_chinh_data (JSON từ mock_api_server.py hoặc vendor API thật)",
        "source": "data/api_json/taichinh_HK*.json",
        "inject_error_rates": {
            "JSON_cono_tinh_sai": "3.0%",
            "JSON_ngay_dong_sai_format": "2.5%",
            "JSON_dadong_vuot_phi": "1.0%",
            "JSON_hocky_sai_format": "1.5%",
            "JSON_tien_mien_giam_am": "0.5%",
            "JSON_thieu_truong": "0.8%"
        }
    },
    "expectations": [
        {
            "expectation_type": "expect_table_row_count_to_be_between",
            "kwargs": {
                "min_value": 1,
                "max_value": null
            },
            "meta": {
                "exp_id": "EXP-TC-01",
                "category": "completeness",
                "notes": "File JSON phải có ít nhất 1 record. Rỗng = API không trả dữ liệu hoặc file JSON bị corrupt."
            }
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "ma_sinh_vien"
            },
            "meta": {
                "exp_id": "EXP-TC-02",
                "category": "completeness",
                "notes": "Mã SV không được NULL — không thể map về dim_sinh_vien nếu thiếu."
            }
        },
        {
            "expectation_type": "expect_column_values_to_not_be_null",
            "kwargs": {
                "column": "hoc_ky"
            },
            "meta": {
                "exp_id": "EXP-TC-03",
                "category": "completeness",
                "notes": "Học kỳ không được NULL — cần để join với dim_hoc_ky."
            }
        },
        {
            "expectation_type": "expect_column_values_to_match_regex",
            "kwargs": {
                "column": "ma_sinh_vien",
                "regex": "^B2[1-4]DC[A-Z]{2,3}[0-9]{3}$",
                "mostly": 0.95
            },
            "meta": {
                "exp_id": "EXP-TC-04",
                "category": "validity",
                "notes": "Format mã SV chuẩn PTIT. mostly=0.95 vì API vendor đôi khi trả mã uppercase đúng, nhưng inject_errors có thể tạo một số format sai."
            }
        },
        {
            "expectation_type": "expect_column_values_to_match_regex",
            "kwargs": {
                "column": "hoc_ky",
                "regex": "^HK[12]-[0-9]{4}-[0-9]{2}$",
                "mostly": 0.983
            },
            "meta": {
                "exp_id": "EXP-TC-05",
                "category": "validity",
                "notes": "Format học kỳ chuẩn. mostly=0.983 vì inject_errors tạo ~1.5% format sai (HK1_2024_25, Ky1-2024-25...)."
            }
        },
        {
            "expectation_type": "expect_compound_columns_to_be_unique",
            "kwargs": {
                "column_list": [
                    "ma_sinh_vien",
                    "hoc_ky"
                ]
            },
            "meta": {
                "exp_id": "EXP-TC-06",
                "category": "uniqueness",
                "notes": "Mỗi SV chỉ có 1 bản ghi tài chính cho mỗi học kỳ. Duplicate = API bị gọi nhiều lần hoặc pagination bị lỗi."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "hoc_phi_phai_dong",
                "min_value": 0,
                "max_value": null,
                "mostly": 0.99
            },
            "meta": {
                "exp_id": "EXP-TC-07",
                "category": "validity",
                "notes": "Học phí phải đóng >= 0 VND. Khoảng 4.8M - 7.5M tùy số tín chỉ."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "da_dong",
                "min_value": 0,
                "max_value": null,
                "mostly": 0.99
            },
            "meta": {
                "exp_id": "EXP-TC-08",
                "category": "validity",
                "notes": "Số tiền đã đóng >= 0. SV chưa đóng = 0, không phải NULL."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "con_no",
                "min_value": 0,
                "max_value": null,
                "mostly": 0.968
            },
            "meta": {
                "exp_id": "EXP-TC-09",
                "category": "validity",
                "notes": "Nợ học phí >= 0. mostly=0.968 vì inject_errors tạo ~3% con_no sai (vendor API làm tròn sai hoặc da_dong > hoc_phi). Transform sẽ recalculate: con_no = max(0, hoc_phi - da_dong)."
            }
        },
        {
            "expectation_type": "expect_column_values_to_be_between",
            "kwargs": {
                "column": "so_tien_mien_giam",
                "min_value": 0,
                "max_value": null,
                "mostly": 0.994
            },
            "meta": {
                "exp_id": "EXP-TC-10",
                "category": "validity",
                "notes": "Tiền miễn giảm >= 0. mostly=0.994 vì inject_errors tạo ~0.5% giá trị âm (vendor bug khi SV không được miễn giảm)."
            }
        },
        {
            "expectation_type": "expect_table_columns_to_match_set",
            "kwargs": {
                "column_set": [
                    "ma_sinh_vien",
                    "hoc_ky",
                    "hoc_phi_phai_dong",
                    "da_dong",
                    "con_no",
                    "duoc_mien_giam",
                    "ly_do_mien_giam",
                    "so_tien_mien_giam",
                    "ngay_dong_cuoi"
                ],
                "exact_match": false
            },
            "meta": {
                "exp_id": "EXP-TC-11",
                "category": "schema",
                "notes": "9 trường theo contract API vendor. exact_match=false vì inject_errors xóa ngay_dong_cuoi ở ~0.8% records — field này optional trong schema."
            }
        }
    ]
}
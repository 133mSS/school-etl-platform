                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "success"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "green"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",

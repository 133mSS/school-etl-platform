        {
            "id": 10,
            "title": "🔍 Kết quả Task theo DAG Run gần nhất",
            "type": "table",
            "gridPos": {
                "x": 12,
                "y": 12,
                "w": 12,
                "h": 7
            },
            "options": {
                "showHeader": true,
                "sortBy": [
                    {
                        "displayName": "Task",
                        "desc": false
                    }
                ]
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Trạng thái"
                        },
                        "properties": [
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "success": {
                                                "text": "✅ Success",
                                                "color": "green"
                                            },
                                            "failed": {
                                                "text": "❌ Failed",
                                                "color": "red"
                                            },
                                            "skipped": {
                                                "text": "⏭️ Skipped",
                                                "color": "yellow"
                                            },
                                            "running": {
                                                "text": "🔄 Running",
                                                "color": "blue"
                                            },
                                            "upstream_failed": {
                                                "text": "⬆️ Upstream Failed",
                                                "color": "orange"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-text"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Thời gian (giây)"
                        },
                        "properties": [
                            {
                                "id": "thresholds",
                                "value": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "yellow",
                                            "value": 60
                                        },
                                        {
                                            "color": "orange",
                                            "value": 300
                                        },
                                        {
                                            "color": "red",
                                            "value": 600
                                        }
                                    ]
                                }
                            },
                            {
                                "id": "custom.cellOptions",
                                "value": {
                                    "type": "color-background"
                                }
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "rawSql": "WITH latest_run AS (SELECT dag_id, MAX(run_id) as latest_run_id FROM dag_run WHERE state IN ('success', 'failed') AND dag_id LIKE '$dag_id' GROUP BY dag_id) SELECT ti.task_id AS \"Task\", ti.dag_id AS \"DAG\", ti.state AS \"Trạng thái\", ROUND(ti.duration::numeric, 1) AS \"Thời gian (giây)\", TO_CHAR(ti.start_date AT TIME ZONE 'Asia/Ho_Chi_Minh', 'HH24:MI:SS') AS \"Bắt đầu\", TO_CHAR(ti.end_date AT TIME ZONE 'Asia/Ho_Chi_Minh', 'HH24:MI:SS') AS \"Kết thúc\" FROM task_instance ti JOIN latest_run lr ON ti.dag_id = lr.dag_id AND ti.run_id = lr.latest_run_id ORDER BY ti.dag_id, ti.start_date",
                    "refId": "A",
                    "format": "table",
                    "datasource": {
                        "type": "postgres",
                        "uid": "airflow-db"
                    }
                }
            ],
            "datasource": {
                "type": "postgres",
                "uid": "airflow-db"
            }
        },
        {

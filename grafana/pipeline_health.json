                                    "mode": "fixed",
                                    "fixedColor": "red"
                                }
                            }
                        ]
                    }
                ]
            },
            "targets": [
                {
                    "rawSql": "SELECT DATE_TRUNC('hour', start_date) AS time, COUNT(CASE WHEN state='success' THEN 1 END) AS success, COUNT(CASE WHEN state='failed' THEN 1 END) AS failed FROM dag_run WHERE dag_id LIKE '$dag_id' AND start_date >= NOW() - INTERVAL '7 days' GROUP BY 1 ORDER BY 1",

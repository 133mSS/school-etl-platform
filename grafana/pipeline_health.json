{
    "title": "Pipeline Health - ETL Platform PTIT",
    "uid": "pipeline-health-v4",
    "schemaVersion": 36,
    "version": 4,
    "refresh": "30s",
    "time": {
        "from": "now-7d",
        "to": "now"
    },
    "tags": [
        "etl",
        "pipeline",
        "monitoring",
        "airflow"
    ],
    "description": "Giám sát sức khỏe ETL Pipeline — DAG runs, Data Quality, Records processed",
    "templating": {
        "list": [
            {
                "name": "dag_id",
                "label": "DAG",
                "type": "query",
                "query": "SELECT DISTINCT dag_id FROM dag_run ORDER BY dag_id",
                "datasource": {
                    "type": "postgres",
                    "uid": "airflow-db"
                },
                "includeAll": true,
                "allValue": "%"
            },
            {
                "name": "time_range",
                "label": "Khoảng thời gian",
                "type": "interval",
                "query": "1h,6h,12h,1d,3d,7d,14d,30d",
                "current": {
                    "text": "7d",
                    "value": "7d"
                },
                "auto": false,
                "refresh": 2,
                "sort": 0
            }
        ]
    },
    "annotations": {
        "list": [
            {
                "name": "Pipeline Failures",
                "datasource": {
                    "type": "postgres",
                    "uid": "airflow-db"
                },
                "rawQuery": true,
                "rawSql": "SELECT EXTRACT(EPOCH FROM start_date) * 1000 AS time, CONCAT('❌ FAILED: ', dag_id) AS text, 'failure' AS tags FROM dag_run WHERE state = 'failed' AND start_date >= NOW() - INTERVAL '7 days' ORDER BY start_date",
                "enable": true,
                "hide": false,
                "iconColor": "red",
                "type": "dashboard"
            }
        ]
    },
    "panels": [

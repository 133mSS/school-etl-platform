                        ]
                    }
                ]
            },
            "targets": [
                {
                    "rawSql": "SELECT dag_id AS \"DAG\", run_id AS \"Run ID\", state AS \"Trạng thái\", TO_CHAR(start_date AT TIME ZONE 'Asia/Ho_Chi_Minh', 'YYYY-MM-DD HH24:MI:SS') AS \"Thời gian bắt đầu\", TO_CHAR(end_date AT TIME ZONE 'Asia/Ho_Chi_Minh', 'HH24:MI:SS') AS \"Kết thúc\", CASE WHEN end_date IS NOT NULL THEN ROUND(EXTRACT(EPOCH FROM (end_date - start_date)) / 60.0, 1) ELSE NULL END AS \"Thời gian chạy (phút)\", COALESCE(conf::text, '{}') AS \"Config\" FROM dag_run WHERE dag_id LIKE '$dag_id' ORDER BY start_date DESC LIMIT 30",

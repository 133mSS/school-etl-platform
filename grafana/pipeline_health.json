                "graphMode": "none"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "green"
                    }
                }
            },
            "targets": [
                {
                    "rawSql": "SELECT COUNT(*) as total FROM dag_run WHERE state = 'success' AND dag_id LIKE '$dag_id' AND start_date >= NOW() - INTERVAL '7 days'",
                    "refId": "A",
                    "format": "table",
                    "datasource": {
                        "type": "postgres",
                        "uid": "airflow-db"
                    }

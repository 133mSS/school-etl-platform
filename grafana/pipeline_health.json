            "targets": [
                {
                    "rawSql": "SELECT 'fact_hoc_tap' as table_name, COUNT(*) as record_count FROM fact_hoc_tap UNION ALL SELECT 'fact_ctsv', COUNT(*) FROM fact_ctsv UNION ALL SELECT 'fact_tai_chinh', COUNT(*) FROM fact_tai_chinh UNION ALL SELECT 'dim_sinh_vien', COUNT(*) FROM dim_sinh_vien WHERE la_ban_hien_tai = TRUE UNION ALL SELECT 'dim_hoc_phan', COUNT(*) FROM dim_hoc_phan UNION ALL SELECT 'agg_student_summary', COUNT(*) FROM agg_student_summary ORDER BY record_count DESC",
                    "refId": "A",
                    "format": "table",
                    "datasource": {
                        "type": "postgres",

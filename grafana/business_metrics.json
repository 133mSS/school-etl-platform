                {
                    "rawSql": "SELECT sv.ma_sinh_vien, sv.ho_ten, sv.ten_nganh, sv.khoa_hoc, agg.gpa_he_4, agg.diem_rl_trung_binh as diem_rl, agg.tong_no_hoc_phi as no_hp, agg.muc_do_rui_ro, CASE WHEN agg.canh_bao_hoc_vu THEN 'Co' ELSE 'Khong' END as canh_bao FROM agg_student_summary agg JOIN dim_sinh_vien sv ON agg.sinh_vien_key = sv.sinh_vien_key AND sv.la_ban_hien_tai = TRUE WHERE agg.muc_do_rui_ro IN ('Cao', 'Rat cao', 'Trung binh') ORDER BY CASE agg.muc_do_rui_ro WHEN 'Rat cao' THEN 1 WHEN 'Cao' THEN 2 WHEN 'Trung binh' THEN 3 END, agg.gpa_he_4 ASC LIMIT 50",

            "targets": [
                {
                    "rawSql": "SELECT sv.ma_sinh_vien as \"Mã SV\", sv.ho_ten as \"Họ Tên\", sv.ten_nganh as \"Ngành\", sv.khoa_hoc as \"Khóa\", agg.gpa_he_4 as \"GPA\", agg.diem_rl_trung_binh as \"DRL\", CASE WHEN agg.tong_no_hoc_phi > 0 THEN 'Có' ELSE 'Không' END as \"Nợ HP\", agg.muc_do_rui_ro as \"Rủi ro\" FROM agg_student_summary agg JOIN dim_sinh_vien sv ON agg.sinh_vien_key = sv.sinh_vien_key WHERE sv.la_ban_hien_tai = TRUE AND sv.trang_thai_hoc_tap = 'Đang học' AND agg.gpa_he_4 > 0 AND (agg.gpa_he_4 < 2.0 OR agg.tong_no_hoc_phi > 0 OR agg.diem_rl_trung_binh < 50) ORDER BY agg.gpa_he_4 ASC, agg.tong_no_hoc_phi DESC LIMIT 100",
                    "refId": "A",
                    "format": "table"
                }
            ],
            "datasource": {
                "type": "postgres",
                "uid": "afh6y8b8xe1hcc"

            "targets": [
                {
                    "rawSql": "SELECT t.ngay_bat_dau as time, ROUND(AVG(f.diem_he_4)::numeric, 2) as gpa_tb FROM fact_hoc_tap f JOIN dim_hoc_ky t ON f.hoc_ky_key = t.hoc_ky_key WHERE f.diem_he_4 IS NOT NULL GROUP BY t.ngay_bat_dau ORDER BY t.ngay_bat_dau ASC",
                    "refId": "A",
                    "format": "time_series"
                }

            "targets": [
                {
                    "rawSql": "WITH sv_in_term AS (SELECT DISTINCT f.sinh_vien_key, sv.khoa_hoc FROM fact_hoc_tap f JOIN dim_sinh_vien sv ON f.sinh_vien_key = sv.sinh_vien_key AND sv.la_ban_hien_tai = TRUE JOIN dim_hoc_ky hk ON f.hoc_ky_key = hk.hoc_ky_key WHERE hk.ma_hoc_ky = '$hoc_ky') SELECT s.khoa_hoc, ROUND(100.0 * SUM(CASE WHEN tc.con_no > 0 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) as pct_no FROM sv_in_term s LEFT JOIN fact_tai_chinh tc ON s.sinh_vien_key = tc.sinh_vien_key AND tc.hoc_ky_key = (SELECT hoc_ky_key FROM dim_hoc_ky WHERE ma_hoc_ky = '$hoc_ky') GROUP BY s.khoa_hoc ORDER BY s.khoa_hoc",
                    "refId": "A",
                    "format": "table"
                }
            ],
            "datasource": {
                "type": "postgres",
                "uid": "afh6y8b8xe1hcc"
            }
